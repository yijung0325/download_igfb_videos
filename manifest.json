{
  "manifest_version": 3,
  "name": "IG/FB/X URL Saver",
  "version": "1.4.0",
  "description": "Save Instagram, Facebook, and X content URLs with optional notes; edit/delete entries; export CSV; keeps media indexes.",
  "permissions": [
    "storage",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://www.facebook.com/*",
    "https://facebook.com/*",
    "https://m.facebook.com/*",
    "https://x.com/*",
    "https://www.x.com/*",
    "https://m.x.com/*",
    "https://mobile.x.com/*",
    "https://twitter.com/*",
    "https://www.twitter.com/*",
    "https://m.twitter.com/*",
    "https://mobile.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "IG/FB/X URL Saver"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*",
        "https://www.facebook.com/*",
        "https://facebook.com/*",
        "https://m.facebook.com/*",
        "https://x.com/*",
        "https://www.x.com/*",
        "https://m.x.com/*",
        "https://mobile.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://m.twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
